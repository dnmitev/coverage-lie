{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json",
    "progress"
  ],
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "typescriptChecker": {
    "experimentalNativePreview": true
  },
  "incremental": true,
  "ignoreStatic": false,
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
